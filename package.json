{
    "name": "lanehash",
    "version": "1.0.1",
    "description": "A fast non-cryptographic 64-bit hash designed for JavaScript engines: pure 32-bit integer math (no BigInt, no WebAssembly), strings hashed straight from UTF-16 without encoding, byte-identical results for strings and their UTF-16LE bytes, streaming, seeds, and 64/53/32-bit or hex output. For hash tables, sharding, cache keys and dedupe — not for security.",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check-exports": "publint && attw --pack .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "quality": "npm run build && node scripts/quality.mjs",
        "bench": "npm --prefix bench install --no-audit --no-fund --silent && npm run build && node bench/run.mjs",
        "smoke": "node scripts/smoke.mjs",
        "size": "size-limit",
        "pack:verify": "npm pack --dry-run",
        "changeset": "changeset",
        "release": "npm run build && node scripts/publish-if-new.mjs",
        "prepare": "husky"
    },
    "keywords": [
        "hash",
        "hashing",
        "hash-function",
        "non-cryptographic",
        "fast-hash",
        "64-bit",
        "string-hash",
        "xxhash",
        "murmurhash",
        "fnv",
        "cyrb53",
        "checksum",
        "fingerprint",
        "hash-table",
        "sharding",
        "consistent-hashing",
        "cache-key",
        "dedupe",
        "bloom-filter",
        "streaming",
        "utf-16",
        "pure-javascript",
        "no-wasm",
        "typescript",
        "zero-dependencies"
    ],
    "author": "Pavel Lazarchuk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PavelLazarchuk/lanehash.git"
    },
    "bugs": {
        "url": "https://github.com/PavelLazarchuk/lanehash/issues"
    },
    "homepage": "https://github.com/PavelLazarchuk/lanehash#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@size-limit/preset-small-lib": "^13.0.3",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "tsup": {
            "esbuild": "^0.28.2"
        }
    }
}
